{
  "name": "@null-city/simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "null-city-sim": "./dist/cli/index.js",
    "null-city-verify-receipt": "./dist/cli/receipt-verify.js",
    "null-city-run": "./dist/cli/run.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node ./dist/cli/index.js"
  },
  "dependencies": {
    "@null-city/contracts": "workspace:*",
    "@null-city/epistemics": "workspace:*",
    "@null-city/scenario-schema": "workspace:*",
    "@null-city/test-fixtures": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}