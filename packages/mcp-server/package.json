{
  "name": "@null-city/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "null-city-mcp": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node ./dist/cli.js",
    "example": "node examples/quickstart.mjs",
    "example:llm": "node examples/llm-openai-policy.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@null-city/contracts": "workspace:*",
    "@null-city/sdk": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@null-city/epistemics": "workspace:*",
    "@null-city/server": "workspace:*",
    "@null-city/test-fixtures": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
